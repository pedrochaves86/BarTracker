rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate session IDs
    function isValidId(id) {
      return id is string && id.size() >= 4 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow get, create: if isValidId(sessionId);
      
      match /friends/{friendId} {
        allow read: if true;
        allow write: if true;
      }
      
      match /menu/{itemId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
